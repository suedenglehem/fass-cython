# Example docker/.env — setup.sh writes the real one (git-ignored).
# compose reads the file at every `up`; after install the Config tab's
# Apply owns the folder paths and scripts/web.sh re-syncs this file from
# <config>/config.json before every start (every non-volume line is
# preserved, so FASS_GPU / FASS_HTTP_PORT etc. survive).
FASS_INPUT_DIR=/srv/fass/input
FASS_OUTPUT_DIR=/srv/fass/output
FASS_LOG_DIR=/srv/fass/log
FASS_CONFIG_DIR=/srv/fass/config
# 1 = nvidia-smi found on the host, 0 = CPU-only (GPU commands generate,
# execution refused)
FASS_GPU=1
# host GPU index fass's ffmpeg encodes on (nvidia-smi -L order); 0 = the
# single-GPU-host answer
FASS_GPU_PIN=0
# IN-CONTAINER index the pin maps to (0 for pin 0, 1 for any non-zero
# pin — see the comment in compose.yaml). Never the raw host index.
FASS_GPU_CVD=0
# host port of the fass-http sidecar (HLS/DASH stream runs)
FASS_HTTP_PORT=8080
